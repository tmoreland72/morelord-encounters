<section class="ml-app ml-app-shell ml-encounters-settings">
  <header class="ml-hero ml-encounters-settings__header">
    <div>
      <h2>Morelord Encounters Settings</h2>
      <p>Configure encounter content access for this world.</p>
    </div>
  </header>

  <form class="ml-encounters-settings__form">
    <section class="ml-settings-section">
      <div class="ml-settings-section__heading">
        <div>
          <h3><i class="fa-solid fa-books"></i> Monster Sources</h3>
          <p>Review the encounter source books available to this world.</p>
        </div>
      </div>

      <section class="ml-access-card" data-state="{{#if access.connected}}active{{else}}locked{{/if}}">
        <div class="ml-access-card__icon">
          <i class="fa-solid fa-crown"></i>
        </div>

        <div class="ml-access-card__body">
          <strong>Encounters Content Access</strong>

          {{#if access.connected}}
            <span>Connected with {{access.tierLabel}}</span>
          {{else}}
            {{#if access.coreActive}}
              <span>Connect a Morelord account to unlock entitled Encounters content.</span>
            {{else}}
              <span>Morelord Core must be enabled to manage premium access.</span>
            {{/if}}
          {{/if}}

          {{#if access.validatedAtLabel}}
            <small>Access last checked {{access.validatedAtLabel}}</small>
          {{/if}}
        </div>

        <div class="ml-access-card__actions">
          <button type="button" data-action="manageAccount">
            <i class="fa-solid fa-user-gear"></i>
            {{#if access.connected}}Manage Account{{else}}Connect Account{{/if}}
          </button>

          {{#if access.connected}}
            <button type="button" data-action="refreshAccess">
              <i class="fa-solid fa-rotate"></i> Refresh
            </button>
          {{/if}}
        </div>
      </section>

      <div class="ml-stack ml-encounters-content-pack-list" data-gap="2">
        <article class="ml-surface ml-encounters-content-pack {{#if access.features.standard}}is-active{{/if}}">
          <div><strong>Encounters Standard</strong><p>SRD compendiums.</p><small>encounters.standard</small></div>
          <span class="ml-badge" data-tone="{{#if access.features.standard}}success{{else}}warning{{/if}}">{{#if access.features.standard}}Available{{else}}Access Required{{/if}}</span>
        </article>
        <article class="ml-surface ml-encounters-content-pack {{#if access.features.premium}}is-active{{/if}}">
          <div><strong>Encounters Premium</strong><p>All installed monster source books, including SRD, core, and third-party content.</p><small>encounters.premium</small></div>
          <span class="ml-badge" data-tone="{{#if access.features.premium}}success{{else}}warning{{/if}}">{{#if access.features.premium}}Available{{else}}Access Required{{/if}}</span>
        </article>
      </div>
    </section>
  </form>
</section>
