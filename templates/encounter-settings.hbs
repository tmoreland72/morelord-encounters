<section class="ml-app ml-app-shell ml-encounters-settings">
  <header class="ml-hero"><i class="fa-solid fa-hydra ml-hero__icon"></i><div class="ml-hero__body"><h1>Morelord Encounters Settings</h1><p>Configure encounter content access for this world.</p></div></header>

  <section class="ml-surface ml-stack">
    <div class="ml-section-heading"><div><h2>Morelord Account</h2><p>Review account access and manage your connection through Morelord Core.</p></div></div>
      <section class="ml-access-card" data-state="{{#if access.connected}}active{{else}}locked{{/if}}">
        <div class="ml-access-card__icon">
          <i class="fa-solid fa-crown"></i>
        </div>

        <div class="ml-access-card__body">
          <strong>Morelord Account</strong>

          {{#if access.connected}}
            <span>Connected with {{access.tierLabel}}</span>
          {{else}}
            {{#if access.coreActive}}
              <span>Connect a Morelord account to unlock entitled Encounters content.</span>
            {{else}}
              <span>Morelord Core must be enabled to manage premium access.</span>
            {{/if}}
          {{/if}}

          {{#if access.validatedAtLabel}}
            <small>Access last checked {{access.validatedAtLabel}}</small>
          {{/if}}
        </div>

        <div class="ml-access-card__actions">
          <button type="button" data-action="manageAccount">
            <i class="fa-solid fa-user-gear"></i>
            {{#if access.connected}}Manage Account{{else}}Connect Account{{/if}}
          </button>

          {{#if access.connected}}
            <button type="button" data-action="refreshAccess">
              <i class="fa-solid fa-rotate"></i> Refresh
            </button>
          {{/if}}
        </div>
      </section>
  </section>

  <form class="ml-stack">
    <section class="ml-surface ml-stack">
      <div class="ml-section-heading">
        <div>
          <h2><i class="fa-solid fa-books"></i> Monster Sources</h2>
          <p>Licensed books still have to be enabled in dnd5e Configure Sources and selected in Encounter Source.</p>
        </div>
      </div>



      <div class="ml-stack" data-gap="2">
        <article class="ml-card ml-item-row">
          <div class="ml-stack" data-gap="1"><strong>Encounters Standard</strong><p>SRD compendiums. The license does not add them unless dnd5e Configure Sources enables them and Encounter Source selects them.</p></div>
          <div class="ml-cluster">
            {{#each standardBadges}}<span class="ml-badge" data-tone="{{tone}}">{{text}}</span>{{/each}}
          </div>
        </article>
        <article class="ml-card ml-item-row">
          <div class="ml-stack" data-gap="1"><strong>Encounters Premium</strong><p>Core and third-party monster books. The license does not add them unless dnd5e Configure Sources enables them and Encounter Source selects them.</p></div>
          <div class="ml-cluster">
            {{#each premiumBadges}}<span class="ml-badge" data-tone="{{tone}}">{{text}}</span>{{/each}}
          </div>
        </article>
      </div>
    </section>
  </form>
  <footer class="ml-page-footer ml-actions"><button type="button" data-action="closeSettings">Close</button></footer>
</section>
